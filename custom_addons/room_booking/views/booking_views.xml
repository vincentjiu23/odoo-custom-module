<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--                  BOOKING: LIST (TREE) VIEW                    -->
    <!-- ============================================================ -->

    <record id="view_room_booking_tree" model="ir.ui.view">
        <field name="name">room.booking.tree</field>
        <field name="model">room.booking</field>
        <field name="arch" type="xml">
            <tree string="Pemesanan Ruangan"
                  decoration-info="status == 'ongoing'"
                  decoration-success="status == 'done'"
                  decoration-muted="status == 'draft'">
                <field name="name" string="Nomor Pemesanan"/>
                <field name="room_id" string="Ruangan"/>
                <field name="room_type" string="Tipe Ruangan" optional="show"/>
                <field name="booking_name" string="Nama Pemesan"/>
                <field name="booking_date" string="Tanggal"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'ongoing'"
                       decoration-success="status == 'done'"/>
            </tree>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                    BOOKING: FORM VIEW                         -->
    <!-- ============================================================ -->

    <record id="view_room_booking_form" model="ir.ui.view">
        <field name="name">room.booking.form</field>
        <field name="model">room.booking</field>
        <field name="arch" type="xml">
            <form string="Pemesanan Ruangan">
                <header>
                    <!-- Process button: visible in Draft and On Going -->
                    <button name="action_process"
                            string="Proses Pemesanan"
                            type="object"
                            class="oe_highlight"
                            invisible="status == 'done'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,ongoing,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informasi Pemesanan">
                            <field name="room_id"
                                   options="{'no_create': True}"
                                   readonly="status != 'draft'"/>
                            <field name="booking_name"
                                   placeholder="Nama pemesan ruangan"
                                   readonly="status != 'draft'"/>
                            <field name="booking_date"
                                   readonly="status != 'draft'"/>
                        </group>
                        <group string="Info Ruangan">
                            <field name="room_type" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Catatan" name="notes">
                            <field name="notes"
                                   placeholder="Catatan tambahan untuk pemesanan ini..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                    BOOKING: SEARCH VIEW                       -->
    <!-- ============================================================ -->

    <record id="view_room_booking_search" model="ir.ui.view">
        <field name="name">room.booking.search</field>
        <field name="model">room.booking</field>
        <field name="arch" type="xml">
            <search string="Cari Pemesanan">
                <field name="name" string="Nomor Pemesanan"/>
                <field name="room_id" string="Ruangan"/>
                <field name="booking_name" string="Nama Pemesan"/>

                <filter string="Draft" name="filter_draft"
                        domain="[('status', '=', 'draft')]"/>
                <filter string="On Going" name="filter_ongoing"
                        domain="[('status', '=', 'ongoing')]"/>
                <filter string="Done" name="filter_done"
                        domain="[('status', '=', 'done')]"/>
                <separator/>
                <filter string="Hari Ini" name="filter_today"
                        domain="[('booking_date', '=', context_today().strftime('%Y-%m-%d'))]"/>

                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'status'}"/>
                    <filter string="Ruangan" name="group_room"
                            context="{'group_by': 'room_id'}"/>
                    <filter string="Tanggal" name="group_date"
                            context="{'group_by': 'booking_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                   BOOKING: WINDOW ACTION                      -->
    <!-- ============================================================ -->

    <record id="action_room_booking" model="ir.actions.act_window">
        <field name="name">Pemesanan Ruangan</field>
        <field name="res_model">room.booking</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_room_booking_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat pemesanan ruangan pertama!
            </p>
            <p>
                Pesan ruangan, lacak status pemesanan, dan kelola
                jadwal penggunaan ruangan secara efisien.
            </p>
        </field>
    </record>

</odoo>
