<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_record_wizard_form" model="ir.ui.view">
        <field name="name">custom.record.wizard.form</field>
        <field name="model">custom.record.wizard</field>
        <field name="arch" type="xml">
            <form string="Batch Update Record Status">
                <group>
                    <field name="target_state" widget="radio"/>
                    <field name="reason" placeholder="Enter reason or approval notes..."/>
                </group>
                <notebook>
                    <page string="Target Records" name="target_records">
                        <field name="record_ids" readonly="1">
                            <tree>
                                <field name="name"/>
                                <field name="title"/>
                                <field name="partner_id"/>
                                <field name="state"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_apply" string="Update Status" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_custom_record_wizard" model="ir.actions.act_window">
        <field name="name">Batch Status Update</field>
        <field name="res_model">custom.record.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_custom_record"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
