<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tag Tree View -->
    <record id="view_custom_tag_tree" model="ir.ui.view">
        <field name="name">custom.tag.tree</field>
        <field name="model">custom.tag</field>
        <field name="arch" type="xml">
            <tree string="Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Tag Form View -->
    <record id="view_custom_tag_form" model="ir.ui.view">
        <field name="name">custom.tag.form</field>
        <field name="model">custom.tag</field>
        <field name="arch" type="xml">
            <form string="Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tag Action -->
    <record id="action_custom_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">custom.tag</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define classification tags to categorize custom records.
            </p>
        </field>
    </record>
</odoo>
