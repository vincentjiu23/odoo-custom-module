<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_custom_record_tree" model="ir.ui.view">
        <field name="name">custom.record.tree</field>
        <field name="model">custom.record</field>
        <field name="arch" type="xml">
            <tree string="Custom Records"
                  decoration-info="state == 'in_progress'"
                  decoration-warning="state == 'approved'"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancelled'"
                  sample="1">
                <field name="priority" widget="priority" nolabel="1"/>
                <field name="name"/>
                <field name="title"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="date"/>
                <field name="deadline" widget="remaining_days"/>
                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" invisible="1"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'in_progress'"
                       decoration-warning="state == 'approved'"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_custom_record_form" model="ir.ui.view">
        <field name="name">custom.record.form</field>
        <field name="model">custom.record</field>
        <field name="arch" type="xml">
            <form string="Custom Record">
                <header>
                    <button name="action_in_progress" string="Start Work" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_done" string="Mark as Completed" type="object"
                            class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'in_progress', 'approved')"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,approved,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger"
                            invisible="state != 'cancelled'"/>
                    <widget name="web_ribbon" title="Completed" bg_color="text-bg-success"
                            invisible="state != 'done'"/>

                    <div class="oe_title">
                        <span class="o_form_label" invisible="state != 'draft'">Draft Record</span>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="title" placeholder="e.g. System Integration Analysis"
                                   required="1"/>
                        </h2>
                    </div>

                    <group>
                        <group name="left_details">
                            <field name="partner_id" widget="res_partner_many2one"
                                   context="{'show_address': 1}" options="{'always_reload': True}"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color', 'no_create_edit': True}"/>
                        </group>
                        <group name="right_details">
                            <field name="date"/>
                            <field name="deadline"/>
                            <field name="is_overdue" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="priority" widget="priority"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Write detailed specification or context here..."/>
                        </page>
                        <page string="Internal Notes" name="internal_notes">
                            <field name="notes" placeholder="Notes for internal team only..."/>
                        </page>
                        <page string="Other Info" name="other_info">
                            <group>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_custom_record_kanban" model="ir.ui.view">
        <field name="name">custom.record.kanban</field>
        <field name="model">custom.record</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="title"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <progressbar field="state"
                             colors='{"draft": "muted", "in_progress": "info", "approved": "warning", "done": "success"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click p-2 shadow-sm rounded">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="text-primary"><field name="name"/></strong>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="fw-bold mb-1">
                                <field name="title"/>
                            </div>
                            <div class="text-muted small mb-2" t-if="record.partner_id.raw_value">
                                <i class="fa fa-user me-1"/> <field name="partner_id"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 border-top pt-2">
                                <span class="fw-semibold text-success">
                                    <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </span>
                                <field name="user_id" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_custom_record_search" model="ir.ui.view">
        <field name="name">custom.record.search</field>
        <field name="model">custom.record</field>
        <field name="arch" type="xml">
            <search string="Search Custom Records">
                <field name="name" string="Reference"/>
                <field name="title" string="Title"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="tag_ids"/>

                <filter string="My Records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="In Progress" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Completed" name="filter_done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Overdue" name="filter_overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>

                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Assigned To" name="group_by_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Partner" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_custom_record" model="ir.actions.act_window">
        <field name="name">Custom Records</field>
        <field name="res_model">custom.record</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_custom_record_search"/>
        <field name="context">{'search_default_my_records': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Custom Record!
            </p>
            <p>
                Track business activities, set milestones, collaborate with team members via chatter, and manage records through a structured lifecycle.
            </p>
        </field>
    </record>
</odoo>
